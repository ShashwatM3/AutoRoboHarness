      "props": {
        "action": "place",
        "args": {
          "target": "$task.target"
        }
      }
    },
    {
      "id": "rule:grasp-default",
      "type": "Rule",
      "label": "Use a one-hand grasp; it is the fastest way to pick",
      "props": {
        "when": [],
        "then": {
          "param": "grasp.mode",
          "value": "one_hand"
        },
        "priority": 0
      }
    },
    {
      "id": "rule:backroom-torso",
      "type": "Rule",
      "label": "Backroom totes sit on the low rack; keep the torso at level 1 there",
      "props": {
        "when": [],
        "then": {
          "param": "torso.level",
          "value": 1
        },
        "priority": 0
      }
    },
    {
      "id": "rule:retract-before-drive",
      "type": "Rule",
      "label": "Never drive with the arm extended",
      "props": {
        "when": [],
        "then": {
          "param": "arm.retract_before_drive",
          "value": true
        },
        "priority": 0
      }
    },
    {
      "id": "guard:max-speed",
      "type": "Guardrail",
      "label": "Drive no faster than 0.8 m/s on the shop floor",
      "props": {
        "param": "max_speed_mps",
        "op": "<=",
        "value": 0.8,
        "locked": true
      }
    },
    {
      "id": "proto:slot-mismatch",
      "type": "Protocol",
      "label": "If a slot holds the wrong item, report it and do not take it",
