      "id": "proc:pick",
      "type": "Procedure",
      "label": "Pick an order item from its shelf slot into the packing tote",
      "props": {
        "task": "PICK"
      }
    },
    {
      "id": "step:pick:go-to-item",
      "type": "Step",
      "label": "Drive to the bay that holds the item",
      "props": {
        "action": "navigate_to",
        "args": {
          "waypoint": "$task.source_waypoint"
        }
      }
    },
    {
      "id": "step:pick:reach",
      "type": "Step",
      "label": "Reach into the item's slot",
      "props": {
        "action": "reach",
        "args": {
          "slot": "$task.source"
        }
      }
    },
    {
      "id": "step:pick:grasp",
      "type": "Step",
      "label": "Close the gripper on the item",
      "props": {
        "action": "grasp",
        "args": {
          "mode": "$rule.grasp.mode"
        }
      }
    },
    {
      "id": "step:pick:retract",
      "type": "Step",
      "label": "Pull the arm back in before driving",
      "props": {
        "action": "retract",
        "args": {}
      }
    },
    {
      "id": "step:pick:go-to-tote",
      "type": "Step",
      "label": "Drive to the packing tote",
      "props": {
        "action": "navigate_to",
        "args": {
          "waypoint": "$task.target_waypoint"
        }
      }
    },
    {
      "id": "step:pick:place",
      "type": "Step",
      "label": "Put the item in the tote",
      "props": {
        "action": "place",
        "args": {
          "target": "$task.target"
        }
      }
    },
    {
      "id": "proc:restock",
      "type": "Procedure",
      "label": "Restock an item from the backroom tote into its shelf slot",
      "props": {
        "task": "RESTOCK"
      }
    },
    {
      "id": "step:restock:go-to-backroom",
      "type": "Step",
      "label": "Drive to the backroom tote",
      "props": {
        "action": "navigate_to",
        "args": {
          "waypoint": "$task.source_waypoint"
        }
      }
    },
    {
      "id": "step:restock:reach",
      "type": "Step",
      "label": "Reach into the tote",
      "props": {
        "action": "reach",
        "args": {
          "slot": "$task.source"
        }
      }
    },
    {
      "id": "step:restock:grasp",
      "type": "Step",
      "label": "Close the gripper on the item",
      "props": {
        "action": "grasp",
        "args": {
